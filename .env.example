# OpenRouter API key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Flologix Social: reuse the Supabase variables above. No production values here.
# Choose a currently available OpenRouter model ID. Leave blank to use manual drafting.
SOCIAL_AI_MODEL=
# Generate at least 32 random bytes. Never expose as NEXT_PUBLIC.
SOCIAL_WORKER_SECRET=
SOCIAL_WORKER_BASE_URL=http://localhost:3000
# Keep false until explicit live-test authorisation and API access verification.
SOCIAL_LIVE_PUBLISHING=false
# Set the Meta Graph version supported by your approved app.
SOCIAL_META_API_VERSION=
# Server secret JSON: workspace UUID -> channel -> account_id and access_token.
# Store real tokens in your hosting secret manager, never in git.
SOCIAL_META_CONNECTIONS={}
# Optional failure emails. Requires a verified Resend sender domain.
RESEND_API_KEY=
SOCIAL_ALERT_FROM=

# Dedicated Social AI key; no fallback to the general-agent key. Configure provider-side limits.
SOCIAL_OPENROUTER_API_KEY=
